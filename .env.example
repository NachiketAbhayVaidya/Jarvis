# Free API key from https://console.groq.com/keys
GROQ_API_KEY=gsk-your-key-here
GROQ_MODEL=openai/gpt-oss-20b

# openWakeWord
WAKE_WORD_MODEL=hey_jarvis
WAKE_WORD_THRESHOLD=0.5

# edge-tts voice, e.g. en-GB-RyanNeural, en-US-GuyNeural, en-US-AriaNeural
TTS_VOICE=en-GB-RyanNeural

# Gnani AI — Prisma STT + Timbre TTS (required for the challenge build)
GNANI_API_KEY=vach_1ytE2CY5X2PJnyGJqCwFInMcofxRDltMWyyNs6jJ1tXouJvEFTxVgY4fkUm1KMf8Wh7SPhZzDvjhuG0twBJZOGN0AbBOtXvt_f00ee92e530f318fa12c6ae8b24ae2ab
GNANI_LANGUAGE_CODE=hi-IN
GNANI_PREFERRED_LANGUAGE=hi-IN
GNANI_TTS_VOICE=Pranav

# Gnani Inya Shield / armour365 voice biometrics. Keep these blank to run
# without the biometric gate while developing.
GNANI_BIOMETRICS_ENABLED=false
GNANI_BIOMETRIC_TOKEN=
GNANI_BIOMETRIC_ACCESS_KEY=
GNANI_BIOMETRIC_USER_ID=
GNANI_BIOMETRIC_SPEAKER=jarvis-owner
